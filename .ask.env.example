# Copy to .ask.env (gitignored). Never put live tokens in this example or in git.
# Cursor MCP stubs use ${env:NAME} and read these from the environment.
# Export them (or `set -a; source .ask.env; set +a`) before starting Cursor.

ASK_TRACKER=
ASK_TRACKER_URL=
GITHUB_TOKEN=
JIRA_URL=
JIRA_PERSONAL_TOKEN=

# Optional stage model overrides (role, pool, or one-runtime slug). See _ask/bindings/README.md
# ASK_RISK=LOW
# ASK_MODEL_07_REVIEW=diverse
# ASK_MODEL_01_GRILL=thinking
# ASK_MODEL_07_REVIEW_CURSOR=
# ASK_WORK_ID=
