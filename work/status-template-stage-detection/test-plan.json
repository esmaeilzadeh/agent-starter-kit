      "runner_id": "status-cli-integration",
      "case_id": "test_status_stage_detection.StatusStageDetection.test_blank_templates_report_seeded",
      "source_paths": ["_ask/scripts/status.sh", "_ask/tests/test_status_stage_detection.py"]
    },
    {
      "id": "STATUS-FINDINGS",
      "criterion_ids": ["STATUS-001"],
      "type": "integration",
      "change_kind": "new",
      "scenario": {
        "given": "A committed review has findings but an empty verdict, and plan has no meaningful content",
        "when": "The actual status command reports its stage",
        "then": ["Findings alone do not advance the stage to reviewed"]
      },
      "expected_assertions": [
        {
          "criterion_id": "STATUS-001",
          "checks": ["JSON stage is not reviewed"]
        }
      ],
      "runner_id": "status-cli-integration",
      "case_id": "test_status_stage_detection.StatusStageDetection.test_findings_without_verdict_do_not_report_reviewed",
