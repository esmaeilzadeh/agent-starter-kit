{
  "schema": "ask-spec/v1",
  "work_id": "structured-agentic-environment",
  "revision": 3,
  "criteria": [
    {
      "id": "EM-001",
      "given": "A broad typed model or malformed graph/reference/lifecycle",
      "when": "Standalone validation runs",
      "then": [
        "Valid models are accepted and duplicate/broken identities, illegal edges/cardinality/cycles, malformed fields and lifecycle conflicts produce precise nonmutating diagnostics"
      ],
      "verification_mode": "tests"
    },
    {
      "id": "EM-002",
      "given": "A valid Engineering Model with decisions and dependent tasks",
      "when": "A digest-bound semantic edit or concurrent stale edit is submitted",
      "then": [
        "Through a pre/post-validated action, attributable history, revisions, blockers and transitive decision invalidation persist; invalid/stale changes cannot publish or overwrite the last stable state"
      ],
      "verification_mode": "tests"
    },
    {
      "id": "EM-003",
      "given": "Canonical scenario/test references and coordinator evidence, possibly missing, tampered or historical",
      "when": "Read-only scenario and evidence projection runs",
      "then": [
        "Assertions, actual outcomes and revision provenance are inspected through existing authority; missing/invalid/historical evidence is honest and inspection writes nothing"
      ],
      "verification_mode": "tests"
    },
    {
      "id": "EM-004",
      "given": "One revisioned model used by agents and humans",
      "when": "Public CLI validates, projects JSON/Markdown and performs a decision journey",
      "then": [
        "Both projections retain identical IDs/digest and task/attention state, useful errors preserve data and CLI edits survive reload"
      ],
      "verification_mode": "tests"
    },
    {
      "id": "EM-005",
      "given": "A validated workstream snapshot and canonical evidence references",
      "when": "Interactive work/scenario inspection runs",
      "then": [
        "UI displays canonical assertions/tests/revisions and honest evidence states, consuming the shared validated snapshot without duplicating domain-validation or repair rules"
      ],
      "verification_mode": "tests"
    },
    {
      "id": "EM-006",
      "given": "An attention item, valid/invalid decision form or concurrently changed definition",
      "when": "The developer records a reasoned choice then reloads, or submits a stale/invalid form",
      "then": [
        "A valid choice persists and changes task attention; stale or invalid submissions reject without writes"
      ],
      "verification_mode": "tests"
    },
    {
      "id": "EM-007",
      "given": "Current and candidate document states, referenced specifications, external saves and concurrent changes",
      "when": "Any state-changing engineering action or specification change is admitted and published",
      "then": [
        "Validate the current stable state before invoking the action and the complete resulting state afterward; failures or stale identities prevent publication",
        "Every spec change invalidates affected validation, including linked-spec-only edits; startup/action/read checks recover from missed external-save events",
        "Readers consume one validated generation, with content/dependency/rule-bound identity; incremental/cache behavior agrees with full validation and no broken or mixed state is actionable",
        "Each enumerated public state-changing entry point uses the same guard; successful execution records exactly one pre-check, action, post-check and publication in order against captured input/result identities"
      ],
      "verification_mode": "tests"
    },
    {
      "id": "EM-008",
      "given": "An admitted epic, recorded stories, canonical scenarios, reviewed task scopes and tests with multiple relationships",
      "when": "The developer navigates one connected Epic to Story to Scenario to Task to Test to Result hierarchy",
      "then": [
        "Meaningful titles, one connected hierarchy and parent context preserve recorded story membership and many-to-many links; shared tests are deduplicated and missing stories or links remain visible without invented containment",
        "The opening overview explains purpose, scenario coverage, task status, known test results and attention without expanding all source or raw JSON"
      ],
      "verification_mode": "tests"
    },
    {
      "id": "EM-009",
      "given": "A current checkout, local live work refs, archived works and unavailable or gitless sources",
      "when": "The workbench chooses its initial work or the developer browses another branch or revision",
      "then": [
        "The current branch work opens by default; checkout, selected work and inspected source are distinct",
        "Committed cross-branch inspection reads one validated revision and its matching source/evidence without switching checkout, changing refs or enabling semantic edits; unavailable artifacts are explained"
      ],
      "verification_mode": "tests"
    },
    {
      "id": "EM-010",
      "given": "A decomposed task graph with scoped tests, actual runtime evidence, blockers and decisions",
      "when": "The developer filters tasks, opens a summary indicator or resolves an editable decision",
      "then": [
        "Planned, active, blocked and completed tasks are discoverable with descriptions, dependencies, scenarios, tests and recorded implementation evidence",
        "Every summary count opens its exact records as a filter of the same hierarchy; blockers name their cause and decisions show available choices and guarded resolution",
        "No missing history or declared done lifecycle is promoted to verified completion"
      ],
      "verification_mode": "tests"
    },
    {
      "id": "EM-011",
      "given": "A selected test, qualified source selector, execution history and current or historical candidate",
      "when": "The developer inspects source, outcomes, failures, run details and technical identifiers",
      "then": [
        "Source is syntax highlighted and corresponds to the selected qualified test and revision; results match work, test, run and contract identities",
        "Passed, failed, not run, unavailable, stale, historical, skipped and runtime-error states preserve actual meaning; missing time and duration are explicit",
        "Debug identifiers remain collapsed initially and have explanations, copyable values and usable artifact links or commands; execution pass remains distinct from incomplete verification history"
      ],
      "verification_mode": "tests"
    },
    {
      "id": "EM-012",
      "given": "The workbench and recorded local performance baseline, including narrow and keyboard-only usage",
      "when": "The redesigned UI is exercised in a real browser with measured loading and navigation",
      "then": [
        "Responsive list-detail navigation, accessible labels/focus/contrast and non-color status text allow the primary inspection and decision journeys",
        "Initial Overview performs no test-source or evidence scan; selected detail loads lazily and cache refresh or changed inputs cannot hide stale or tampered evidence",
        "Pilot latency budgets are measured with documented samples and misses; a technology replacement requires observed limitations and a reviewed amendment"
      ],
      "verification_mode": "tests"
    }
  ]
}
