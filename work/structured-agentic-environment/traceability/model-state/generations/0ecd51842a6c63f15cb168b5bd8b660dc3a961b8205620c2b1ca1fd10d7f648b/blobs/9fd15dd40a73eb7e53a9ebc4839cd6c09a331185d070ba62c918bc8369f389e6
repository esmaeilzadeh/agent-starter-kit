{
  "schema": "ask-feature-spec/v1",
  "id": "spec-test-traceability",
  "status": "CURRENT",
  "authority": {
    "request": "Implement the referenced plans; 2026-10-08 user authorization",
    "implementation_started": true
  },
  "extends": "specs/current/harness-review.md",
  "objective": "Every testable accepted spec criterion has planned, meaningfully reviewed tests and executed evidence; missing links block normal completion.",
  "non_goals": [
    "Proving correctness from passing tests",
    "Inferring test coverage from free-form prose at runtime",
    "Security sandboxing or multi-host coordination",
    "Replacing unrelated legacy scripts",
    "Running R3-R5 comparative pilots"
  ],
  "requirements": [
    {
      "id": "TT-001",
      "behavior": "Accepted spec criteria have stable IDs and observable Given/When/Then outcomes in canonical JSON.",
      "acceptance": "Unknown, duplicate or omitted required criterion IDs are rejected."
    },
    {
      "id": "TT-002",
      "behavior": "The JSON test plan maps every testable criterion to explicit required test types and test IDs.",
      "acceptance": "A criterion requiring unit and E2E cannot be completed with unit coverage alone. Review-only criteria require a reason and attributable authorized decision."
    },
    {
      "id": "TT-003",
      "behavior": "Every planned and new/changed behavior test traces to accepted criteria and a concrete behavior scenario.",
      "acceptance": "Unmapped tests, nonexistent criteria, empty Then outcomes and missing expected assertions reject the plan or its review."
    },
    {
      "id": "TT-004",
      "behavior": "Independent review assesses coverage adequacy, test type, assertions and a plausible incorrect implementation each test would detect.",
      "acceptance": "Missing/rejected/stale per-criterion or per-test review blocks completion. Blanket APPROVED is insufficient."
    },
    {
      "id": "TT-005",
      "behavior": "Python runner adapters collect actual per-test execution outcomes at the exact candidate revision.",
      "acceptance": "Missing, skipped, xfailed, errored or failed required cases, collection errors and zero collected tests block success even if a process exits zero."
    },
    {
      "id": "TT-006",
      "behavior": "New or changed behavior tests have executed TDD red and green evidence tied to their criterion and case identity.",
      "acceptance": "Red is a recognized failing behavior case, not an import/setup failure. Green is the final candidate run. Review assesses assertion continuity when test code changed; existing policy controls explicit exemptions."
    },
    {
      "id": "TT-007",
      "behavior": "Spec, plan, test source, review and execution identities are bound to immutable revisions/digests.",
      "acceptance": "Changed criteria, removed E2E obligations, stale review/test source or evidence for a different candidate/run are rejected."
    },
    {
      "id": "TT-008",
      "behavior": "All normal completion entrypoints use one Python validation implementation.",
      "acceptance": "Verification, task integration, acceptance checks and record-result pass cannot bypass required traceability. Negative fixtures cannot record pass."
    },
    {
      "id": "TT-009",
      "behavior": "Task verification uses an explicitly planned task subset; final verification requires the entire accepted test plan.",
      "acceptance": "A task-scoped passing result cannot be reused as final workstream completion or arbitrarily narrowed by caller flags."
    },
    {
      "id": "TT-010",
      "behavior": "Metadata and result migrations preserve historical evidence and consumer configuration.",
      "acceptance": "Legacy unlinked test reports remain readable history but do not satisfy the new contract. Missing metadata produces an explicit migration-required refusal."
    },
    {
      "id": "TT-011",
      "behavior": "Final evidence presents each spec criterion, required test types, test IDs, review, TDD status and final execution artifacts.",
      "acceptance": "A deliberately omitted E2E case appears as missing evidence and blocks completion; a fully linked real unit/E2E fixture succeeds."
    }
  ],
  "limits": [
    "Validators establish structural completeness and execution provenance; independent review judges whether scenarios/assertions correctly represent the spec.",
    "A test-type label alone does not establish that a test exercises an end-to-end journey.",
    "The cooperative coordinator boundary and human semantic authority remain unchanged."
  ]
}
