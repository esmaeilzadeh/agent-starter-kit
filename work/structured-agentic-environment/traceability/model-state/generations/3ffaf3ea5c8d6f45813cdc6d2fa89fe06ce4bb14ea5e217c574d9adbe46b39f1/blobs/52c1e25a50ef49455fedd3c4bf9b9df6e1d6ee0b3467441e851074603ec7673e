{
  "schema": "ask-spec/v1",
  "work_id": "harness-review",
  "revision": 1,
  "feature_specification": "specs/current/spec-test-traceability.json",
  "criteria": [
    {
      "id": "TT-001",
      "given": "Canonical JSON contains duplicate, unknown or empty criterion identities/outcomes",
      "when": "The criterion registry and linked plan are validated",
      "then": [
        "Unknown, duplicate or omitted required criterion IDs are rejected."
      ],
      "verification_mode": "tests"
    },
    {
      "id": "TT-002",
      "given": "An accepted criterion requires both unit and E2E evidence",
      "when": "Only unit coverage is planned or completed",
      "then": [
        "A criterion requiring unit and E2E cannot be completed with unit coverage alone. Review-only criteria require a reason and attributable authorized decision."
      ],
      "verification_mode": "tests"
    },
    {
      "id": "TT-003",
      "given": "A planned or changed test lacks a criterion link, scenario outcome or assertion",
      "when": "Plan and changed-test inventory review run",
      "then": [
        "Unmapped tests, nonexistent criteria, empty Then outcomes and missing expected assertions reject the plan or its review."
      ],
      "verification_mode": "tests"
    },
    {
      "id": "TT-004",
      "given": "Semantic review is blank, rejected, incomplete or bound to old source",
      "when": "Normal completion evaluates the independent decision",
      "then": [
        "Missing/rejected/stale per-criterion or per-test review blocks completion. Blanket APPROVED is insufficient."
      ],
      "verification_mode": "tests"
    },
    {
      "id": "TT-005",
      "given": "A real case is missing, skipped, failed, errored, duplicated or not collected",
      "when": "The Python adapter executes required cases",
      "then": [
        "Missing, skipped, xfailed, errored or failed required cases, collection errors and zero collected tests block success even if a process exits zero."
      ],
      "verification_mode": "tests"
    },
    {
      "id": "TT-006",
      "given": "New or changed behavior has historical red and final candidate execution",
      "when": "TDD continuity and phase provenance are evaluated",
      "then": [
        "Red is a recognized failing behavior case, not an import/setup failure. Green is the final candidate run. Review assesses assertion continuity when test code changed; existing policy controls explicit exemptions."
      ],
      "verification_mode": "tests"
    },
    {
      "id": "TT-007",
      "given": "A candidate edits obligations or a bound source, review, run or log identity changes",
      "when": "Completion reloads coordinator-pinned evidence",
      "then": [
        "Changed criteria, removed E2E obligations, stale review/test source or evidence for a different candidate/run are rejected."
      ],
      "verification_mode": "tests"
    },
    {
      "id": "TT-008",
      "given": "The same complete or incomplete workstream is submitted through normal public commands",
      "when": "Verify, integration, result recording and acceptance evaluate completion",
      "then": [
        "Verification, task integration, acceptance checks and record-result pass cannot bypass required traceability. Negative fixtures cannot record pass."
      ],
      "verification_mode": "tests"
    },
    {
      "id": "TT-009",
      "given": "Tasks have explicitly accepted subsets of a larger test plan",
      "when": "A task verifies its subset or a task report is submitted as final evidence",
      "then": [
        "A task-scoped passing result cannot be reused as final workstream completion or arbitrarily narrowed by caller flags."
      ],
      "verification_mode": "tests"
    },
    {
      "id": "TT-010",
      "given": "Metadata or pinned-runner capability is missing or legacy reports exist",
      "when": "Migration or new completion is requested",
      "then": [
        "Legacy unlinked test reports remain readable history but do not satisfy the new contract. Missing metadata produces an explicit migration-required refusal."
      ],
      "verification_mode": "tests"
    },
    {
      "id": "TT-011",
      "given": "A required E2E case is present or deliberately omitted",
      "when": "The final per-criterion evidence report is derived",
      "then": [
        "A deliberately omitted E2E case appears as missing evidence and blocks completion; a fully linked real unit/E2E fixture succeeds."
      ],
      "verification_mode": "tests"
    }
  ]
}
