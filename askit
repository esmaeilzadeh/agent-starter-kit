#!/usr/bin/env bash
# askit — installer and daily command for the Agent Starter Kit.
#   curl -fsSL https://raw.githubusercontent.com/esmaeilzadeh/agent-starter-kit/main/askit | bash
#   askit self-install   # same, when you already have this file
# In an ask-based git repo (_ask/ + ./ask): same as ./ask.
# Otherwise: refuse non-git folders; ask before adding the kit. No silent overlay.
set -euo pipefail

ASKIT_CURL='curl -fsSL https://raw.githubusercontent.com/esmaeilzadeh/agent-starter-kit/main/askit | bash'

askit_self_install_usage() {
  cat <<EOF
askit self-install — put this command on PATH

Usage:
  $ASKIT_CURL
  askit self-install [--source <git-url-or-path>] [--ref <branch-or-tag>] [--prefix <dir>] [--here]

  --source   kit git URL or local clone (default: GitHub main repo)
  --ref      branch or tag to check out (default: main)
  --prefix   install prefix; askit goes in <prefix>/bin (default: ~/.local)
  --here     also overlay the kit into the current git repo

Then in an app git repo:
  askit
  # confirm to add ask, then use askit like ./ask
  askit setup   # tracker/MCP wizard (after the repo is ask-based)
EOF
}

askit_self_install() {
  local SOURCE="${KIT_SOURCE_REPO:-https://github.com/esmaeilzadeh/agent-starter-kit.git}"
  local REF="${KIT_REF:-main}"
  local PREFIX="${ASKIT_PREFIX:-$HOME/.local}"
  local HERE=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --source) SOURCE="$2"; shift 2 ;;
      --ref) REF="$2"; shift 2 ;;
      --prefix) PREFIX="$2"; shift 2 ;;
      --here) HERE=1; shift ;;
      -h|--help)
        askit_self_install_usage
        return 0
        ;;
      *)
        echo "askit: unknown self-install arg $1 (try --help)" >&2
        return 2
        ;;
    esac
  done

  if [[ -z "${HOME:-}" ]]; then
    echo "askit: HOME is not set" >&2
    return 1
  fi

  local CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/askit/kit"
  local BIN="$PREFIX/bin"

  echo "askit: kit $SOURCE @ $REF"
  echo "askit: cache $CACHE"

  mkdir -p "$(dirname "$CACHE")" "$BIN"

  if [[ -d "$CACHE/.git" ]]; then
    git -C "$CACHE" remote set-url origin "$SOURCE" 2>/dev/null || git -C "$CACHE" remote add origin "$SOURCE"
    git -C "$CACHE" fetch --depth 1 origin "$REF"
    git -C "$CACHE" checkout -f --detach FETCH_HEAD
  else
    rm -rf "$CACHE"
    if ! git clone --depth 1 --branch "$REF" "$SOURCE" "$CACHE" 2>/dev/null; then
      git clone "$SOURCE" "$CACHE"
      git -C "$CACHE" checkout "$REF"
    fi
  fi

  if [[ ! -x "$CACHE/askit" ]]; then
    echo "askit: $CACHE/askit missing after clone" >&2
    return 1
  fi

  ln -sfn "$CACHE/askit" "$BIN/askit"
  echo "askit: $BIN/askit -> $CACHE/askit"

  ASKIT_SKIP_COMPLETION_INSTALL="${ASKIT_SKIP_COMPLETION_INSTALL:-}" \
    ASKIT_DIR="$CACHE" "$CACHE/_ask/scripts/install-user-completion.sh" >/dev/null 2>&1 || true

  if [[ "$HERE" -eq 1 ]]; then
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      echo "askit: --here is not applicable in a non-git folder" >&2
      return 1
    fi
    if [[ "${ASKIT_ADD_ASK:-}" != "1" ]]; then
      if [[ ! -t 0 || ! -t 1 ]]; then
        echo "askit: --here would add ask capability. Re-run in a terminal and confirm." >&2
        return 1
      fi
      echo "askit: --here adds ask capability to $(git rev-parse --show-toplevel)."
      printf "Add ask capability to this repo? [y/N] "
      local here_ans=""
      read -r here_ans || true
      case "$here_ans" in
        y|Y|yes|YES) ;;
        *)
          echo "askit: not adding ask."
          return 1
          ;;
      esac
    fi
    "$CACHE/ask" install --skip-prepare "$(git rev-parse --show-toplevel)"
  fi

  case ":$PATH:" in
    *":$BIN:"*) ;;
    *)
      echo "askit: $BIN is not on PATH. Add this to your shell rc:"
      echo "  export PATH=\"$BIN:\$PATH\""
      ;;
  esac

  echo "askit: done. In an app git repo, run askit and confirm to add the kit."
}

# Piped to bash (curl | bash): this file *is* the installer.
_askit0="${0##*/}"
if [[ "$_askit0" == "bash" || "$_askit0" == "sh" || "$_askit0" == "-bash" || "$_askit0" == "-sh" ]]; then
  askit_self_install "$@"
  exit
fi

if [[ "${1:-}" == "self-install" ]]; then
  shift
  askit_self_install "$@"
  exit
fi

askit_home() {
  local s="${BASH_SOURCE[0]}"
  while [[ -L "$s" ]]; do
    local t
    t="$(readlink "$s")"
    if [[ "$t" == /* ]]; then
      s="$t"
    else
      s="$(cd "$(dirname "$s")" && pwd)/$t"
    fi
  done
  cd "$(dirname "$s")" && pwd
}

ASKIT_DIR="$(askit_home)"

askit_git_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

askit_is_ask_repo() {
  local root="$1"
  [[ -n "$root" && -d "$root/_ask" && -x "$root/ask" ]]
}

askit_confirm_add() {
  if [[ "${ASKIT_ADD_ASK:-}" == "1" ]]; then
    return 0
  fi
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "askit: this git repo is not ask-based (need _ask/ and ./ask)." >&2
    echo "askit: re-run in a terminal and confirm to add ask capability." >&2
    return 1
  fi
  echo "askit: this git repo is not ask-based (need _ask/ and ./ask)."
  printf "Add ask capability to this repo? [y/N] "
  local ans=""
  read -r ans || true
  case "$ans" in
    y|Y|yes|YES) return 0 ;;
    *)
      echo "askit: not adding ask."
      return 1
      ;;
  esac
}

askit_add_kit() {
  ASKIT_DIR="$ASKIT_DIR" "$ASKIT_DIR/_ask/scripts/askit-bootstrap.sh"
}

COMPLETE_LIB="$ASKIT_DIR/_ask/scripts/ask-complete.sh"
if [[ -f "$COMPLETE_LIB" ]]; then
  # shellcheck source=scripts/ask-complete.sh
  source "$COMPLETE_LIB"
fi

cmd="${1:-}"
if [[ "$cmd" != "--complete" ]]; then
  ASKIT_DIR="$ASKIT_DIR" "$ASKIT_DIR/_ask/scripts/install-user-completion.sh" >/dev/null 2>&1 || true
fi

git_root="$(askit_git_root || true)"
ask_repo=0
if askit_is_ask_repo "$git_root"; then
  ask_repo=1
fi

if [[ "$cmd" == "--complete" ]]; then
  shift
  if [[ "$ask_repo" -eq 1 ]]; then
    if declare -F ask_print_completions >/dev/null; then
      ask_print_completions "$@"
    fi
  else
    if declare -F ask_complete_emit >/dev/null; then
      ask_complete_emit self-install "put askit on PATH (same as curl | bash)"
    fi
  fi
  exit 0
fi

if [[ "$cmd" == "completion" ]]; then
  if [[ -x "$ASKIT_DIR/ask" ]]; then
    exec "$ASKIT_DIR/ask" completion "${2:-}"
  fi
  echo "askit: completion snippet needs the kit checkout next to this script" >&2
  exit 2
fi

if [[ -z "$git_root" ]]; then
  echo "askit: ask is not applicable in a non-git folder." >&2
  exit 1
fi

if [[ "$ask_repo" -eq 1 ]]; then
  exec "$git_root/ask" "$@"
fi

# Git repo, but not ask-based: never dump kit commands; never overlay silently.
if [[ "$cmd" == "-h" || "$cmd" == "--help" || "$cmd" == "help" ]]; then
  echo "askit: this git repo is not ask-based (need _ask/ and ./ask)." >&2
  echo "askit: run askit here and confirm to add ask capability." >&2
  exit 1
fi

if ! askit_confirm_add; then
  exit 2
fi

askit_add_kit
git_root="$(askit_git_root)"
if [[ ! -x "$git_root/ask" ]]; then
  echo "askit: overlay did not produce ./ask" >&2
  exit 1
fi

if [[ -z "$cmd" ]]; then
  exec "$git_root/ask" --help
fi
if [[ "$cmd" == "setup" && -z "${ASKIT_SKIP_SETUP:-}" ]]; then
  exec "$git_root/ask" setup
fi
exec "$git_root/ask" "$@"
