#!/usr/bin/env bash
# ask — Agent Starter Kit. Thin dispatcher; logic lives under _ask/.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
SCRIPTS="$ROOT/_ask/scripts"
SKILLS="$ROOT/_ask/skills"

usage() {
  cat <<'EOF'
ask — Agent Starter Kit (not a generic scripts/ folder)

Usage: ./ask <command> [args]

Commands:
  check-clean              refuse dirty worktree
  start-work <work-id>     branch agent/<work-id> + seed work/<work-id>/
  check-workstream <id>    preconditions before implement
  verify                   run checks; print commit SHA
  record-result …          provenance (requires --commit-sha)
  sync                     regenerate .cursor projections
  install <repo>           overlay kit package + adapter
  upgrade --version <tag>  refresh kit-owned files
  prepare                  prepare pinned Community Skills

Unknown command names that match a file in _ask/scripts/<name>.sh are exec'd.
EOF
}

cmd="${1:-}"
if [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" || "$cmd" == "help" ]]; then
  usage
  exit 0
fi
shift

case "$cmd" in
  check-clean|check-clean-worktree)
    exec "$SCRIPTS/check-clean-worktree.sh" "$@"
    ;;
  start-work|start)
    exec "$SCRIPTS/start-work.sh" "$@"
    ;;
  check-workstream|check)
    exec "$SCRIPTS/check-workstream.sh" "$@"
    ;;
  verify)
    exec "$SCRIPTS/verify.sh" "$@"
    ;;
  record-result|record)
    exec "$SCRIPTS/record-result.sh" "$@"
    ;;
  sync|sync-cursor-binding)
    exec "$SCRIPTS/sync-cursor-binding.sh" "$@"
    ;;
  install|install-kit)
    exec "$SCRIPTS/install-kit.sh" "$@"
    ;;
  upgrade|upgrade-kit)
    exec "$SCRIPTS/upgrade-kit.sh" "$@"
    ;;
  prepare|prepare-skills)
    exec "$SKILLS/prepare-skills.sh" "$@"
    ;;
  *)
    if [[ -x "$SCRIPTS/${cmd}.sh" ]]; then
      exec "$SCRIPTS/${cmd}.sh" "$@"
    fi
    echo "ask: unknown command '$cmd'" >&2
    usage >&2
    exit 2
    ;;
esac
