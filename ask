#!/usr/bin/env bash
# ask — Agent Starter Kit. Thin dispatcher; logic lives under _ask/.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
SCRIPTS="$ROOT/_ask/scripts"
SKILLS="$ROOT/_ask/skills"

usage() {
  cat <<'EOF'
ask — Agent Starter Kit (not a generic scripts/ folder)

Usage: ./ask <command> [args]
       ./ask [-h|--help|help]

Same help: no command, -h, --help, or help.
In a repo that already has the kit, `askit` prints this same text (it wraps ./ask).

Commands:
  check-clean
      Refuse if the worktree is dirty. No flags.

  start-work <work-id>
      Create branch agent/<work-id> and seed work/<work-id>/.
      <work-id>   required slug

  check-workstream <work-id> [--allow-dirty]
      Preconditions before implement (branch, spec, plan).
      --allow-dirty   skip the clean-tree check

  status [--work-id <id>] [--json]
      Live agent/* plus archived work/* on the default branch (no checkout).
      --work-id <id>   one workstream
      --json           machine-readable rows

  verify
      Run repo checks; print commit SHA. No flags.
      Env: VERIFY_OUT_DIR, VERIFY_JSON

  record-result --work-id <id> --commit-sha <sha> --result <text> [--notes <text>]
      Workstream provenance. Refuses if --commit-sha is missing.

  record-run --run-id <id> --commit-sha <sha> --metric <value> [--notes <text>] [--out <dir>]
      Experiment provenance. --commit-sha must be HEAD. Tree must be clean.
      --out <dir>   default results/<run-id>; needs <dir>/config.yaml

  sync
      Regenerate .cursor/skills and .cursor/commands from _ask/agents/. No flags.

  install [--dry-run] [--force] [--skip-prepare] <target-repo>
      Overlay kit package + adapter onto another git repo.
      --dry-run         print paths; copy nothing
      --force           overwrite existing kit-owned files
      --skip-prepare    skip ./ask prepare and ./ask sync in the target
      <target-repo>     required path; must already be a git repo
      Does not touch that repo's docs/, scripts/, tests/, or src/.

  upgrade --version <tag-or-sha> [--skip-prepare] [--source <git-url>]
      Refresh kit-owned files from an explicit version (never blind main).
      --version <tag-or-sha>   required
      --skip-prepare           skip prepare + sync after refresh
      --source <git-url>       override clone URL (or env KIT_SOURCE_REPO)

  prepare
      Install pinned Community Skills from _ask/skills/manifest.yaml. No flags.
      Env: SKIP_INSTALL=1   validate pins only

  setup
      Human-only tracker + MCP wizard. Needs a TTY. Agents must not run this.
      --help   usage without a TTY

  completion bash|zsh
      Print a tab-completion snippet for this command. Eval it from your shell rc:
      eval "$(./ask completion bash)"
      eval "$(./ask completion zsh)"

Unknown names that match _ask/scripts/<name>.sh are exec'd.
EOF
}

print_completion_snippet() {
  local shell="$1"
  case "$shell" in
    bash)
      cat <<'EOF'
_ask_kit_complete() {
  local ask="${COMP_WORDS[0]}"
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local out line word
  local -a cands=()
  local want_path=0
  out="$("$ask" --complete "$COMP_CWORD" "${COMP_WORDS[@]}" 2>/dev/null)" || out=""
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    word="${line%%	*}"
    if [[ "$word" == __PATH__ ]]; then
      want_path=1
      continue
    fi
    cands+=("$word")
  done <<< "$out"
  if [[ ${#cands[@]} -gt 0 ]]; then
    compopt +o default 2>/dev/null || true
    compopt -o nosort 2>/dev/null || true
    local IFS=$' \t\n'
    COMPREPLY=($(compgen -W "${cands[*]}" -- "$cur"))
  else
    COMPREPLY=()
  fi
  if [[ "$want_path" -eq 1 ]]; then
    compopt -o default 2>/dev/null || true
    compopt -o filenames 2>/dev/null || true
  fi
}
complete -o nosort -F _ask_kit_complete ask
complete -o nosort -F _ask_kit_complete ./ask
complete -o nosort -F _ask_kit_complete askit
EOF
      ;;
    zsh)
      cat <<'EOF'
#compdef ask askit ./ask
_ask_kit_complete() {
  local ask="${words[1]}"
  local out line word desc
  local -a pairs
  local want_path=0
  out="$("$ask" --complete $((CURRENT - 1)) ${words[@]} 2>/dev/null)" || out=""
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    word="${line%%	*}"
    desc="${line#*	}"
    [[ "$word" == "$line" ]] && desc=""
    if [[ "$word" == __PATH__ ]]; then
      want_path=1
      continue
    fi
    if [[ -n "$desc" ]]; then
      pairs+=("${word}:${desc}")
    else
      pairs+=("$word")
    fi
  done <<< "$out"
  if [[ ${#pairs[@]} -gt 0 ]]; then
    _describe -V 'ask' pairs
  fi
  if [[ "$want_path" -eq 1 ]]; then
    _files
  fi
}
compdef _ask_kit_complete ask askit ./ask
EOF
      ;;
    *)
      echo "ask: completion supports bash or zsh" >&2
      exit 2
      ;;
  esac
}

# shellcheck source=scripts/ask-complete.sh
source "$SCRIPTS/ask-complete.sh"

cmd="${1:-}"
if [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" || "$cmd" == "help" ]]; then
  usage
  exit 0
fi
if [[ "$cmd" == "--complete" ]]; then
  shift
  ask_print_completions "$@"
  exit 0
fi
if [[ "$cmd" == "completion" ]]; then
  print_completion_snippet "${2:-}"
  exit 0
fi
shift

case "$cmd" in
  check-clean|check-clean-worktree)
    exec "$SCRIPTS/check-clean-worktree.sh" "$@"
    ;;
  start-work|start)
    exec "$SCRIPTS/start-work.sh" "$@"
    ;;
  check-workstream|check)
    exec "$SCRIPTS/check-workstream.sh" "$@"
    ;;
  status)
    exec "$SCRIPTS/status.sh" "$@"
    ;;
  verify)
    exec "$SCRIPTS/verify.sh" "$@"
    ;;
  record-result|record)
    exec "$SCRIPTS/record-result.sh" "$@"
    ;;
  record-run)
    exec "$SCRIPTS/record-run.sh" "$@"
    ;;
  sync|sync-cursor-binding)
    exec "$SCRIPTS/sync-cursor-binding.sh" "$@"
    ;;
  install|install-kit)
    exec "$SCRIPTS/install-kit.sh" "$@"
    ;;
  upgrade|upgrade-kit)
    exec "$SCRIPTS/upgrade-kit.sh" "$@"
    ;;
  prepare|prepare-skills)
    exec "$SKILLS/prepare-skills.sh" "$@"
    ;;
  setup)
    exec "$SCRIPTS/setup.sh" "$@"
    ;;
  *)
    if [[ -x "$SCRIPTS/${cmd}.sh" ]]; then
      exec "$SCRIPTS/${cmd}.sh" "$@"
    fi
    echo "ask: unknown command '$cmd'" >&2
    usage >&2
    exit 2
    ;;
esac
